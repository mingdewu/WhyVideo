{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WhyExplainerAssetIndexV2",
  "description": "通用项目合法素材目录 Schema (V2) — 记录每个项目在 projects/<project_id>/ 下的音视频/图片素材元数据与授权状态",
  "type": "object",
  "required": [
    "project_id",
    "last_updated",
    "allowed_render_license_statuses",
    "strict_licensing_policy",
    "assets"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "title": {
      "type": "string"
    },
    "last_updated": {
      "type": "string"
    },
    "allowed_render_license_statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["approved", "internal_placeholder"]
      }
    },
    "strict_licensing_policy": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "path",
          "type",
          "duration_seconds",
          "resolution",
          "license_status",
          "source_url",
          "tags"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^AST-(VID|IMG|VEC)-[0-9]{3}$"
          },
          "path": {
            "type": "string",
            "description": "相对于 projects/<project_id>/ 的素材路径，如 assets/video/sample.mp4"
          },
          "file_path": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["video", "image", "vector"]
          },
          "media_type": {
            "type": "string",
            "enum": ["video", "image", "vector"]
          },
          "duration_seconds": {
            "type": ["number", "null"]
          },
          "duration_sec": {
            "type": ["number", "null"]
          },
          "resolution": {
            "type": "string",
            "pattern": "^[0-9]+x[0-9]+$"
          },
          "license_status": {
            "type": "string",
            "enum": [
              "approved",
              "internal_placeholder",
              "pending",
              "pending_verification",
              "rejected",
              "unknown"
            ]
          },
          "source_url": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
